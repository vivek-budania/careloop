# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Stedi *test* key — inject at launch, do not bake into the image or commit it.
# Preferred (container / host when you start uvicorn):
#   STEDI_API_KEY=test_… python3 -m uvicorn backend.main:app --port 8080
#   docker run -e STEDI_API_KEY=test_… …
# Laptop fallback: copy this file to `.env` (gitignored) and fill the line below.
# Vercel: Project Settings → Environment Variables → STEDI_API_KEY, then Redeploy.
# Cursor/cloud-agent env does not reach Vercel.
# Do NOT paste the real value in chat, GitHub, Discord, or a PR.
# Production Stedi keys are out of scope (CareLoop will refuse them).
# Golden path: jane / demo → Aetna → load sample card (Jane Doe / AETNA12345).
# STEDI_API_KEY=
