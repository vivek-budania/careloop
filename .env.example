# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional Groq text fallback if Gemini fails (NOT xAI Grok).
# GROQ_API_KEY=

# Optional xAI Grok speech-to-text for visit scribe (console.x.ai).
# Never commit a real key. Rotate any key pasted into chat.
# XAI_API_KEY=

# Optional. Mock coverage works without this. A Stedi *test* key can probe 270/271;
# fixture member IDs will not match sandbox canned members, so eligibility still
# comes from CareLoop mocks.
# STEDI_API_KEY=