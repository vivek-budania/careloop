# Demo env slots — inject at launch (preferred) or copy this file to gitignored `.env`.
# Extra keys can be added the same way. Never commit real values or paste them in chat.
#
# Preferred (container / host when you start uvicorn):
#   STEDI_API_KEY=test_… GEMINI_API_KEY=… python3 -m uvicorn backend.main:app --port 8080
#   docker run -e STEDI_API_KEY=test_… -e GEMINI_API_KEY=… …
# Vercel: Project Settings → Environment Variables → same names (Production + Preview), then Redeploy.
# Cursor/cloud-agent env does not reach Vercel.
# Profile in the patient shell shows whether each slot is loaded — never the secret.
#
# Golden path: jane / demo → Aetna → Jane Doe / AETNA12345 / DOB 2004-04-04.

# Login only (Auth + public.profiles). Server-side. Never put service_role in frontend JS.
# Seeded user: username jane / email jane@careloop.local / password demo.
# visits + insurance exist in the hosted project (docs/database/) but login does not read them.
SUPABASE_URL=https://cslldhxwtdqqfeltyanm.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Insurance card/SBC read + /letters drafts. Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Stedi *test* key for sandbox 270/271. Production keys are refused.
# STEDI_API_KEY=

# Optional letter fallback if Gemini is down. Not required if Gemini works. Not xAI Grok.
# GROQ_API_KEY=

# Optional xAI Grok speech-to-text for visit scribe (console.x.ai). Seeded transcript works without it.
# XAI_API_KEY=

# Optional. Signs mock login tokens and the coverage cookie so Vercel workers agree.
# The demo fallback works without it. Set this to rotate sessions.
# SESSION_SECRET=
