GEMINI_API_KEY=your_key_here

# Local demo only — copy this file to `.env` (gitignored). Do NOT commit `.env`.
# Do NOT paste the real value in chat, GitHub, Discord, or a PR.
#
# 1. Stedi portal → API keys → Generate (Mode: Test). Name it CareloopDemo.
# 2. Paste the full test_… secret on the next line, no quotes:
# STEDI_API_KEY=test_your_sandbox_key_here
#
# Restart uvicorn after saving. Golden path: log in as jane / demo, pick Aetna,
# load sample card (Jane Doe / AETNA12345 / 2004-04-04), confirm coverage.
# Production Stedi keys are out of scope (CareLoop will refuse them).
STEDI_API_KEY=
